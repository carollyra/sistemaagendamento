# PostgreSQL connection string (Neon). Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Server
PORT=3333
NODE_ENV=development

# Allowed browser origins: one, or several separated by commas.
# Development default: http://localhost:5173
# Production example: CORS_ORIGIN="https://fadebarbearia.com.br,https://www.fadebarbearia.com.br"
CORS_ORIGIN="http://localhost:5173"

# Seed (optional, used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@barbershop.com"
SEED_ADMIN_PASSWORD="admin123"

# Business hours (shop timezone)
BUSINESS_TIMEZONE="America/Sao_Paulo"
BUSINESS_OPENING_TIME="09:00"
BUSINESS_CLOSING_TIME="19:00"
BUSINESS_SLOT_INTERVAL=30
# 0 = Sunday ... 6 = Saturday
BUSINESS_WORKING_DAYS="1,2,3,4,5,6"
